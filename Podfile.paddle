platform :ios, '17.0'
project 'WildOCR.xcodeproj'
target 'WildOCR' do
  use_frameworks!
  pod 'onnxruntime-objc', '~> 1.24'
  pod 'Yams', '~> 5.0'
  pod 'OpenCV', '~> 4.3.0'
end
# Xcode 27.1 does not allow old pod deployment targets (OpenCV 9.0,
# Yams 11.0). The application itself targets iOS 17. Apply the same minimum
# to *every* CocoaPods-generated target/configuration, including aggregate
# targets, so the resolved Pods.xcodeproj remains compatible with Xcode 27.
post_install do |installer|
  minimum_ios_version = '17.0'
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |configuration|
      configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
      configuration.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end
end
